{
  "name": "power-exercise",
  "scripts": {
    "build": "yarn typecheck && parcel build app/index.html",
    "build:clean": "run-s clean build",
    "clean": "shx rm -rf dist .buildinfo || true",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "start": "parcel app/index.html",
    "test:app": "node --experimental-strip-types --test src/model/model.test.ts src/ui/components/reusable/format.test.ts",
    "test:coverage": "jest --coverage",
    "tidy": "yarn install && run-s prettier:fix",
    "typecheck": "tsc --noEmit -p app/tsconfig.json",
    "watch": "tsc -b . --watch"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "bootstrap": "^5.3.8",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "@types/bootstrap": "^5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "buffer": "^5.5.0||^6.0.0",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.4",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-sort-members": "^0.2.5",
    "sass": "^1.108.1",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.18.1"
}
